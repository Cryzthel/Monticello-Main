# Copy to functions/.env (gitignored) and fill in. The Firebase CLI loads it
# for both deploy and runtime. Secrets do NOT go here — see MAIL_SETUP.md.

# "smtp" (the estate Gmail account, the default) or "resend".
# Switch to resend only after the sending domain shows "Verified" in Resend.
MAIL_PROVIDER=smtp

# Resend only. Must be an address on the domain you verified with Resend.
# MAIL_FROM=Monticello Villas <no-reply@mail.your-domain.com>

# Optional. Where a resident's reply goes — the HOA office inbox, not no-reply.
# MAIL_REPLY_TO=hoa-office@your-domain.com
