# Copy to .env.local and fill in.
#
# ONE file serves BOTH apps. Each app's vite.config.js sets `envDir` to this
# directory, so apps/admin-portal and apps/security-portal read these same
# values. That is deliberate: the two consoles talk to the same Firebase
# project, and a per-app copy is a credential that can be rotated in one place
# and forgotten in the other.
#
# .env.local is git-ignored. Never commit real values.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

VITE_MAPBOX_TOKEN=

# Optional. The guardhouse position as "lng,lat" — LONGITUDE FIRST, the
# opposite of what a map app's "copy coordinates" gives you.
#
# Live Dispatch's Acknowledge & Respond routes from the officer's device GPS.
# When the browser cannot give a fix within 100 m — typical on a guardhouse
# desktop, which only has Wi-Fi/IP positioning — the route starts here instead.
# Left blank, an imprecise fix is still used and the route badge labels it
# approximate. Nothing in the repository records where the guardhouse is, so
# this has no default.
VITE_GUARDHOUSE_LNGLAT=

# Optional, Admin Portal only. The sidebar's "Earn while you wait" slot reads
# a sponsored line from this feed while a slow sync is on screen. Blank keeps
# the slot OFF: nothing renders and nothing is requested. The JSON contract is
# in apps/admin-portal/src/lib/sponsorFeed.js. Kickbacks.ai has no web API, so
# this must be a backend you run (e.g. a Cloud Function) — not a Kickbacks URL.
VITE_SPONSOR_FEED_URL=

# ── WHAT IS NOT CONFIGURED HERE ─────────────────────────────────────────────
# Portal identity. There is no VITE_PORTAL any more.
#
# Which portal an app is, is declared once in that app's own vite.config.js as
# a build-time `define` (__PORTAL__). Identity that an ambient environment
# variable can flip — a stray shell export, a CI secret, a copied .env — is not
# an identity, and getting it wrong silently merges the two portals' auth
# sessions. It is a property of the app, so it lives in the app.
#
# The dev ports are likewise fixed in each vite.config.js:
#   Admin Portal       http://localhost:3000
#   Guardhouse Portal  http://localhost:3001
