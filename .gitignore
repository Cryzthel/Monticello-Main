#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase Admin SDK service account keys — never commit these
scripts/serviceAccountKey.json
*serviceAccountKey*.json
crash.txt
# Agent tooling installed locally by the skills CLI / impeccable
.agents/
.codex/
.github/skills/
.github/agents/
.github/hooks/

# PGlite, installed --no-save to run db/test/*.test.mjs
db/test/node_modules/

# Build-time values passed with --dart-define-from-file (Mapbox token etc.).
# Copy dart_defines.example.json and fill it in; never commit the real one.
dart_defines.json

# purge-test-data.js dry-run/execute manifests list account emails and uids.
scripts/purge-manifest-*.json

# Local pre-purge backups: personal data and password hashes. Never commit.
backups/
